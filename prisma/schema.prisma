generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum ProfileVisibility {
  HIDDEN
  MEMBERS
  PUBLIC
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum SourceType {
  DEMO
  USER_SUBMITTED
  AUTHORIZED_IMPORT
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  role          UserRole        @default(MEMBER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  profile       Profile?
  accounts      Account[]
  sessions      Session[]
  reports       ProfileReport[] @relation("ReporterReports")
  auditEvents   AuditEvent[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                String            @id @default(cuid())
  ownerId           String            @unique
  displayName       String
  headline          String?
  bio               String?           @db.Text
  jobTitle          String?
  companyName       String?
  industry          String?
  country           String?
  city              String?
  remotePreference  String?
  yearsExperienceMin Int?
  yearsExperienceMax Int?
  visibility        ProfileVisibility @default(HIDDEN)
  verification      VerificationStatus @default(UNVERIFIED)
  availability      String?
  sourceType        SourceType        @default(USER_SUBMITTED)
  lastVerifiedAt    DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  deletedAt         DateTime?
  owner             User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  skills            ProfileSkill[]
  education         Education[]
  experience        Experience[]
  source            ProfileSource?
  consent           ConsentRecord[]
  reports           ProfileReport[]

  @@index([visibility, deletedAt])
  @@index([city, country])
  @@index([verification])
}

model Skill {
  id             String         @id @default(cuid())
  name           String
  normalizedName String         @unique
  profiles       ProfileSkill[]
}

model ProfileSkill {
  profileId   String
  skillId     String
  proficiency String?
  yearsUsed   Int?
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skill       Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([profileId, skillId])
  @@index([skillId])
}

model Education {
  id               String    @id @default(cuid())
  profileId        String
  institutionName  String
  degree           String?
  department       String?
  graduationYear   Int?
  verification     VerificationStatus @default(UNVERIFIED)
  profile          Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([institutionName, graduationYear])
}

model Experience {
  id          String   @id @default(cuid())
  profileId   String
  companyName String
  jobTitle    String
  industry    String?
  location    String?
  startYear   Int?
  endYear     Int?
  isCurrent   Boolean  @default(false)
  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([companyName, jobTitle])
}

model ProfileSource {
  id                   String     @id @default(cuid())
  profileId            String     @unique
  sourceType           SourceType
  sourceName           String
  sourceUrl            String?
  collectedAt          DateTime   @default(now())
  lastCheckedAt        DateTime?
  authorizationReference String?
  profile              Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id            String    @id @default(cuid())
  profileId     String
  consentType   String
  purposeVersion String
  visibility    ProfileVisibility
  consentedAt   DateTime  @default(now())
  withdrawnAt   DateTime?
  recordedBy    String
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, withdrawnAt])
}

model ProfileReport {
  id          String       @id @default(cuid())
  profileId   String
  reporterId  String
  reason      String
  details     String?      @db.Text
  status      ReportStatus @default(OPEN)
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reporter    User         @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([profileId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  eventType  String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([targetType, targetId])
}
